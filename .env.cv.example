# =============================================================================
# Continuous Verification — example (no secrets)
# Copy to `.env.cv.local` (gitignored)
# =============================================================================

# Environment: local | staging | production
CV_ENVIRONMENT=staging

# Target URLs
# LOCAL_URL=http://localhost:3000
STAGING_URL=
PROD_URL=

# Optional: verify deployed commit matches
# CV_EXPECTED_COMMIT=

# Dry-run (default safe): 1 = no network probes
CV_DRY_RUN=1

# Live probes opt-in: CV_LIVE=1 npm run cv:run
