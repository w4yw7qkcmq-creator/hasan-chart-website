{
  "name": "hasan-chart-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:worker": "node worker/index.js",
    "start:worker:news": "node worker/news-worker.js",
    "subscription-worker": "node worker/subscription-maintenance-worker.js",
    "install:worker": "npm ci --prefix worker --omit=dev || npm install --prefix worker --omit=dev",
    "railway:worker:install": "npm ci --prefix worker --omit=dev",
    "railway:worker:start": "npm start --prefix worker",
    "load-test": "node scripts/load-test.js",
    "smoke": "node scripts/e2e/smoke.mjs",
    "smoke:local": "E2E_ENVIRONMENT=local node scripts/e2e/smoke.mjs",
    "smoke:staging": "E2E_ENVIRONMENT=staging node scripts/e2e/smoke.mjs",
    "smoke:production": "E2E_ENVIRONMENT=production node scripts/e2e/smoke.mjs",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "e2e:provision": "node scripts/e2e/provision.mjs",
    "e2e:verify": "node scripts/e2e/verify-infra.mjs",
    "ops:generate": "node scripts/ops/generate.mjs",
    "ops:verify": "node scripts/ops/verify-ops.mjs",
    "cv:verify": "node scripts/continuous-verification/verify-infra.mjs",
    "cv:test": "node --test scripts/continuous-verification/tests/cv.test.mjs",
    "cv:run": "CV_DRY_RUN=1 node scripts/continuous-verification/run.mjs",
    "cv:run:production": "CV_ENVIRONMENT=production CV_DRY_RUN=1 node scripts/continuous-verification/run.mjs",
    "cv:checkpoint": "CV_DRY_RUN=1 node scripts/continuous-verification/run.mjs",
    "cv:report": "node scripts/continuous-verification/report-cli.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lightweight-charts": "^4.2.0",
    "next": "^14.2.35",
    "node-cron": "^4.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-qr-code": "^2.0.15",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.12",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.52.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.16",
    "tailwindcss": "^3.4.4",
    "typescript": "6.0.3"
  }
}
