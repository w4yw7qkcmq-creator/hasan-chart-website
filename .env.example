# =============================================================================
# HasaN CharT World — Environment Variables (example only, no real secrets)
# Copy to `.env.local` for local development.
# On Railway: set these in each service Variables tab (Web + Worker).
# =============================================================================

# --- Runtime ---
NODE_ENV=production

# --- Site URL (SEO, emails, partner links) ---
# Public canonical URL used in metadata and client-side links.
NEXT_PUBLIC_SITE_URL=https://www.hasanchartworld.com
# Optional server-side fallback (same value as NEXT_PUBLIC_SITE_URL).
SITE_URL=https://www.hasanchartworld.com

# --- Supabase (https://supabase.com/dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Never expose as NEXT_PUBLIC_* or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# News worker reads SUPABASE_URL (set to the same value as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# --- Upstash Redis (rate limiting / security) ---
# https://console.upstash.com — optional but recommended for multi-instance deploys.
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Resend (https://resend.com) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
EMAIL_FROM=HasaN CharT World <noreply@hasanchartworld.com>
EMAIL_REPLY_TO=support@hasanchartworld.com
ADMIN_EMAIL=admin@hasanchartworld.com

# --- Cloudflare Turnstile (https://dash.cloudflare.com) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --- Web Push / VAPID ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:alerts@hasanchartworld.com

# --- Security / Cron ---
# Random string for protected cron routes (check-price-alerts, subscription expiry, etc.)
CRON_SECRET=your_random_cron_secret
# Optional dedicated secret for worker HTTP APIs (falls back to CRON_SECRET).
WORKER_API_SECRET=your_random_worker_api_secret
# 32+ char key for encrypting account-management API credentials at rest.
ACCOUNT_DATA_ENCRYPTION_KEY=your_32_char_or_longer_encryption_key

# --- OpenAI (worker instant analysis + news worker) ---
OPENAI_API_KEY=sk-your_openai_api_key

# --- Railway Worker (instant analysis proxy on Web service) ---
# Server-only URL used by Next.js /api/instant-analysis proxy routes.
RAILWAY_AI_WORKER_URL=https://your-worker.up.railway.app
# Legacy fallback only (avoid setting in new deployments).
NEXT_PUBLIC_RAILWAY_AI_WORKER_URL=https://your-worker.up.railway.app
# Requires migration: supabase/migrations/20260802_instant_analysis_requests.sql

# --- Worker: Price Alerts service (worker/index.js) ---
PORT=3000
PRICE_ALERT_CHECK_INTERVAL_MS=30000

# --- Telegram Content Sync (dedicated bot — NOT the News Worker bot) ---
# Webhook: POST /api/webhooks/telegram-content
TELEGRAM_CONTENT_BOT_TOKEN=your_telegram_content_bot_token
TELEGRAM_CONTENT_WEBHOOK_SECRET=your_random_telegram_content_webhook_secret
TELEGRAM_CONTENT_CHANNEL_DAILY_ANALYSIS=-100xxxxxxxxxx
TELEGRAM_CONTENT_CHANNEL_ACADEMY=-100xxxxxxxxxx
TELEGRAM_CONTENT_CHANNEL_RESULT=-100xxxxxxxxxx
# Optional: in-process album timer scheduling happens automatically per media group.
# Startup recovery runs via instrumentation.js on Web process boot.
# Optional operational recovery (not required for liveness):
# POST /api/cron/telegram-content-finalize with CRON_SECRET

# --- Worker: News service (worker/news-worker.js) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_or_numeric_id
TRADING_ECONOMICS_API_KEY=your_trading_economics_key
# Alternative name accepted by news-worker:
# TRADING_ECONOMICS_CLIENT=your_client:secret

# --- Optional / Diagnostics (do not set in production unless needed) ---
# CSP_REPORT_ONLY=1
# PARTNER_LOG_LEVEL=info
# PRICE_ALERT_TEST_EMAIL=test@example.com
# RAILWAY_GIT_COMMIT_SHA=auto-set-by-railway
# VERCEL_GIT_COMMIT_SHA=auto-set-by-vercel
