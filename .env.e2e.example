# =============================================================================
# HasaN CharT World — E2E / Smoke Test (example only, no secrets)
# Copy to `.env.e2e.local` (gitignored) and fill values locally.
# Never commit real credentials.
# =============================================================================

# Fallback target (used by npm run smoke)
E2E_BASE_URL=https://www.hasanchartworld.com

# Multi-environment URLs (used by smoke:local / smoke:staging / smoke:production)
# LOCAL_URL=http://localhost:3000
STAGING_URL=
PROD_URL=

# Permanent smoke test user (smoke-e2e-user)
E2E_USER_EMAIL=
E2E_USER_PASS=

# Permanent smoke test admin (smoke-e2e-admin)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASS=

# Optional: provisioning only — requires SUPABASE_* in .env.local
# Used by: npm run e2e:provision
